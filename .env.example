# Server-only RPC addresses. The browser never sees them: it talks to /api/rpc/devnet and /api/rpc/mainnet,
# which forward here (src/app/api/rpc/[cluster]/route.ts, src/lib/constants.ts serverRpcUrl).
# Put keyed URLs (for example Helius) in .env.local. Do not commit that file.
DEVNET_RPC_URL=https://api.devnet.solana.com
MAINNET_RPC_URL=https://api.mainnet-beta.solana.com
# PAR records, pictures, and the platform fee. Server only. Do not commit the values.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
