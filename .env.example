# Public RPC endpoints. Devnet is the default cluster in the app.
NEXT_PUBLIC_DEVNET_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_MAINNET_RPC_URL=https://api.mainnet-beta.solana.com

# Optional overrides after scripts/create-config.ts prints a config address.
# Empty values fall through to configs/published.json.
NEXT_PUBLIC_DEVNET_PAR_CONFIG=
NEXT_PUBLIC_DEVNET_DEMO_CONFIG=
NEXT_PUBLIC_MAINNET_PAR_CONFIG=
